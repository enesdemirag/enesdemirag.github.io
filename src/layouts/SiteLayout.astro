---
import { site } from "../data/site";
import "../styles/global.css";

type Props = { title?: string; description?: string; article?: boolean };
const { title, description = site.description, article = false } = Astro.props as Props;
const pageTitle = title ? `${title} — ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { label: "Home", href: "/", active: path === "/" },
  { label: "Experience", href: "/experience/", active: path.startsWith("/experience") },
  { label: "About", href: "/#about", active: false },
  { label: "Blog", href: "/blog/", active: path.startsWith("/blog") },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5efe5" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/images/favicon-circle.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:image" content={new URL("/images/social-preview-image.png", Astro.site)} />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="Enes Demirağ, home">Enes Demirağ</a>
        <nav aria-label="Main navigation">
          {nav.map((item) => <a href={item.href} aria-current={item.active ? "page" : undefined}>{item.label}</a>)}
        </nav>
      </header>
      <main id="main"><slot /></main>
    </div>
  </body>
</html>
