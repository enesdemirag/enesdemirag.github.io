---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib/posts";
const { post } = Astro.props as { post: CollectionEntry<"blog"> };
---

<a class="post-row" href={`/blog/${post.id}/`}>
  <span class="post-copy">
    <span class="post-title">{post.data.title}</span>
    {post.data.description && <span class="post-description">{post.data.description}</span>}
  </span>
  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
</a>

<style>
  .post-row { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; padding: 17px 0; border-top: 1px solid var(--line); color: inherit; text-decoration: none; }
  .post-row:last-child { border-bottom: 1px solid var(--line); }
  .post-copy { display: grid; gap: 2px; }
  .post-title { font-weight: 580; letter-spacing: -.018em; }
  .post-description { color: var(--muted); font-size: .86rem; }
  .post-row:hover .post-title { color: var(--accent); }
  time { flex: none; color: var(--faint); font-size: .78rem; white-space: nowrap; }
  @media (max-width: 600px) { .post-row { display: grid; gap: 3px; } time { order: -1; font-size: .73rem; } }
</style>
