---
import Icon from "./Icon.astro";
import type { LinkItem } from "../site.config";

interface Props {
  items: LinkItem[];
}

const { items } = Astro.props;
---

<span class="stack">
  {items.map((item) => (
    <a
      class="item"
      href={item.href}
      target={item.href.startsWith("http") ? "_blank" : undefined}
      rel="noopener"
      aria-label={item.label}
      data-label={item.label}
    >
      <Icon icon={item.icon} />
    </a>
  ))}
</span>

<style>
  .stack {
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
    padding: 4px 0;
  }
  .item {
    position: relative;
    display: block;
    width: 36px;
    height: 36px;
    margin-left: -10px;
    border: 2px solid var(--bg);
    border-radius: 28%;
    background: var(--bg);
    transition: transform 0.18s ease, margin 0.18s ease;
  }
  .item:first-child {
    margin-left: 0;
  }
  .stack:hover .item {
    margin-left: 4px;
  }
  .stack:hover .item:first-child {
    margin-left: 0;
  }
  .item:hover,
  .item:focus-visible {
    transform: translateY(-3px) rotate(-4deg);
    z-index: 2;
  }
  .item::after {
    content: attr(data-label);
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    translate: -50% 4px;
    padding: 4px 8px;
    border-radius: 6px;
    background: var(--fg);
    color: var(--bg);
    font-size: 0.75rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease, translate 0.15s ease;
  }
  .item:hover::after,
  .item:focus-visible::after {
    opacity: 1;
    translate: -50% 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .item,
    .item::after {
      transition: none;
    }
  }
</style>
