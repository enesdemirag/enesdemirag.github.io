---
import { formatDate, sourceLabel, type Post } from "../lib/posts";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul>
  {posts.map((post) => (
    <li data-source={post.source}>
      <a href={post.href} target={post.external ? "_blank" : undefined} rel={post.external ? "noopener" : undefined}>
        {post.title}{post.external && <span class="ext" aria-label="(external)"> ↗</span>}
      </a>
      <span class="meta">
        <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
        {post.source !== "blog" && <span class="chip">{sourceLabel[post.source]}</span>}
      </span>
    </li>
  ))}
</ul>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  li a {
    color: var(--fg);
    font-weight: 500;
  }
  .ext {
    color: var(--muted);
    font-size: 0.85em;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .chip {
    padding: 0 0.45rem;
    border-radius: 999px;
    background: var(--chip);
    font-size: 0.75rem;
  }
</style>
