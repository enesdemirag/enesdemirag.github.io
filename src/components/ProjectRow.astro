---
import type { Project } from "../data/site";
const { project } = Astro.props as { project: Project };
const Tag = project.href ? "a" : "div";
---

<Tag class="project-row" href={project.href ?? undefined} target={project.href ? "_blank" : undefined} rel={project.href ? "noopener noreferrer" : undefined}>
  <span class="project-logo" aria-hidden="true">
    {project.image ? <img src={project.image} alt="" loading="lazy" /> : <span>{project.monogram}</span>}
  </span>
  <span class="project-copy">
    <span class="project-title">{project.name}</span>
    <span class="project-description">{project.description}</span>
  </span>
  <span class="project-meta">
    <span>{project.eyebrow}</span>
    {project.href && <span aria-hidden="true" class="arrow">↗</span>}
  </span>
</Tag>

<style>
  .project-row { display: grid; grid-template-columns: 50px minmax(0, 1fr) auto; align-items: center; gap: 16px; padding: 18px 0; border-top: 1px solid var(--line); color: inherit; text-decoration: none; }
  .project-row:last-child { border-bottom: 1px solid var(--line); }
  a.project-row:hover .project-title { color: var(--accent); }
  .project-logo { width: 50px; height: 50px; display: grid; place-items: center; overflow: hidden; border: 1px solid var(--line); border-radius: 13px; background: #fff; color: var(--accent); font-size: .8rem; font-weight: 760; letter-spacing: -.06em; }
  .project-logo img { width: 100%; height: 100%; object-fit: contain; }
  .project-copy { display: grid; gap: 2px; min-width: 0; }
  .project-title { font-weight: 680; letter-spacing: -.025em; transition: color .2s; }
  .project-description { color: var(--muted); font-size: .88rem; line-height: 1.45; }
  .project-meta { display: flex; align-items: center; gap: 16px; color: var(--faint); font-size: .74rem; white-space: nowrap; }
  .arrow { font-size: 1.1rem; color: var(--accent); }
  @media (max-width: 650px) { .project-row { grid-template-columns: 46px minmax(0, 1fr) 16px; gap: 12px; } .project-logo { width: 46px; height: 46px; } .project-meta > span:first-child { display: none; } }
</style>
