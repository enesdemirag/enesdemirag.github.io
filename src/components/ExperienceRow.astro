---
import type { Experience } from "../data/experience";
const { item } = Astro.props as { item: Experience };
const Tag = item.href ? "a" : "div";
---

<Tag class="experience-row" href={item.href ?? undefined} target={item.href ? "_blank" : undefined} rel={item.href ? "noopener noreferrer" : undefined}>
  <span class="experience-logo" aria-hidden="true">
    {item.image ? <img src={item.image} alt="" loading="lazy" /> : <span>{item.monogram}</span>}
  </span>
  <span class="experience-copy">
    <span class="experience-name">{item.name}</span>
    <span class="experience-subtitle">{item.subtitle}{item.period && <span class="experience-period"> · {item.period}</span>}</span>
    <span class="experience-description">{item.description}</span>
  </span>
  {item.href && <span class="experience-arrow" aria-hidden="true">↗</span>}
</Tag>

<style>
  .experience-row { display: grid; grid-template-columns: 52px minmax(0, 1fr) 18px; align-items: center; gap: 17px; padding: 18px 0; border-top: 1px solid var(--line); color: inherit; text-decoration: none; }
  .experience-row:last-child { border-bottom: 1px solid var(--line); }
  a.experience-row:hover .experience-name { color: var(--accent); }
  .experience-logo { display: grid; place-items: center; width: 52px; height: 52px; overflow: hidden; border: 1px solid var(--line); border-radius: 13px; background: var(--surface); color: var(--accent); font-size: .86rem; font-weight: 780; letter-spacing: -.05em; }
  .experience-logo img { width: 100%; height: 100%; object-fit: contain; }
  .experience-copy { display: grid; gap: 2px; min-width: 0; }
  .experience-name { color: var(--navy); font-weight: 720; letter-spacing: -.025em; transition: color .2s; }
  .experience-subtitle { color: var(--navy); font-size: .8rem; font-weight: 600; }
  .experience-period { color: var(--faint); font-weight: 400; }
  .experience-description { color: var(--muted); font-size: .84rem; line-height: 1.45; }
  .experience-arrow { color: var(--accent); font-size: 1.1rem; }
  @media (max-width: 600px) { .experience-row { grid-template-columns: 46px minmax(0, 1fr) 16px; gap: 12px; } .experience-logo { width: 46px; height: 46px; } .experience-period { display: block; } }
</style>
