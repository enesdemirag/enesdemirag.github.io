---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { getAllPosts, sourceLabel, type Source } from "../../lib/posts";

const posts = await getAllPosts();
const sources = [...new Set(posts.map((p) => p.source))] as Source[];
---

<Base title="Writing" description="Everything I've written, wherever it was published.">
  <p class="back"><a href="/">← Home</a></p>
  <h1>Writing</h1>

  {sources.length > 1 && (
    <div class="filters" role="group" aria-label="Filter by source">
      <button type="button" data-filter="all" aria-pressed="true">All</button>
      {sources.map((s) => (
        <button type="button" data-filter={s} aria-pressed="false">{sourceLabel[s]}</button>
      ))}
    </div>
  )}

  <PostList posts={posts} />
  <p class="rss"><a href="/rss.xml">RSS feed</a></p>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const items = document.querySelectorAll<HTMLLIElement>("li[data-source]");
  buttons.forEach((btn) =>
    btn.addEventListener("click", () => {
      const f = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      items.forEach((li) => (li.hidden = f !== "all" && li.dataset.source !== f));
    }),
  );
</script>

<style>
  .back {
    margin: 0 0 2rem;
    font-size: 0.95rem;
  }
  h1 {
    font-size: 1.75rem;
    margin: 0 0 1.25rem;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
  }
  button {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.3rem 0.8rem;
    min-height: 32px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  button[aria-pressed="true"] {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }
  .rss {
    margin-top: 2.5rem;
    font-size: 0.875rem;
  }
</style>
