---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PostRow from "../../components/PostRow.astro";
import { getPosts } from "../../lib/posts";
const posts = await getPosts();
---

<SiteLayout title="Blog" description="Essays and notes by Enes Demirağ on software, AI, computer vision, and engineering.">
  <div class="page-intro"><p class="eyebrow">Notes from the Workbench</p><h1>Blog.</h1><p>Ideas, experiments, and things I learned along the way. Posts live here and on other platforms; each title opens the original post.</p></div>
  <section class="content-section"><div class="section-heading"><h2>All Posts <span>{posts.length}</span></h2></div>{posts.map((post) => <PostRow post={post} />)}</section>
</SiteLayout>

<style>.page-intro .eyebrow { margin-bottom: 15px; }.section-heading h2 span { margin-left: 4px; color: var(--faint); font-size: .85rem; vertical-align: 3px; }</style>
