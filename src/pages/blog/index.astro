---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PostRow from "../../components/PostRow.astro";
import { getPosts } from "../../lib/posts";
const posts = await getPosts();
---

<SiteLayout title="Writing" description="Essays and notes by Enes Demirağ on software, AI, computer vision, and engineering.">
  <div class="page-intro"><p class="eyebrow">Notes from the workbench</p><h1>Writing.</h1><p>Ideas, experiments, and things I learned along the way. The archive includes my early writing on robotics, mathematics, and computer vision.</p></div>
  <section class="content-section"><div class="section-heading"><h2>All posts <span>{posts.length}</span></h2><a class="text-link" href="/rss.xml">RSS feed ↗</a></div>{posts.map((post) => <PostRow post={post} />)}</section>
</SiteLayout>

<style>.page-intro .eyebrow { margin-bottom: 15px; }.section-heading h2 span { margin-left: 4px; color: var(--faint); font-size: .85rem; vertical-align: 3px; }</style>
