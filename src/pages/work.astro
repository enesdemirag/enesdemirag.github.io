---
import SiteLayout from "../layouts/SiteLayout.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { projects } from "../data/site";
---

<SiteLayout title="Work" description="Selected AI products and software projects by Enes Demirağ.">
  <div class="page-intro"><p class="eyebrow">Products & experiments</p><h1>Things I've built.</h1><p>A selection of products and side projects, from voice agents to computer vision and consumer apps.</p></div>
  <section class="content-section"><div class="section-heading"><h2>Products</h2></div>{projects.filter((p) => p.featured).map((project) => <ProjectRow project={project} />)}</section>
  <section class="content-section"><div class="section-heading"><h2>More explorations</h2></div>{projects.filter((p) => !p.featured).map((project) => <ProjectRow project={project} />)}</section>
  <p class="closing">More code and experiments live on <a href="https://github.com/enesdemirag" target="_blank" rel="noopener noreferrer">GitHub ↗</a>.</p>
</SiteLayout>

<style>.page-intro .eyebrow { margin-bottom: 15px; }.closing { margin: -20px 0 80px; font-size: .9rem; }</style>
