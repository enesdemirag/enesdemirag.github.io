---
import SiteLayout from "../layouts/SiteLayout.astro";
import { site, experience } from "../data/site";
---

<SiteLayout title="About" description="About Enes Demirağ — AI engineer and product builder based in Istanbul.">
  <div class="page-intro"><p class="eyebrow">A little about me</p><h1>Engineer by craft.<br />Builder by instinct.</h1><p>I’m Enes, an AI engineer based in Istanbul. I like turning messy, real-world problems into useful products and reliable software.</p></div>
  <section class="about-grid content-section">
    <div class="about-copy"><h2>What I do</h2><p>My work spans AI agents, computer vision, MLOps, backend systems, and product engineering. I care about the whole path from an idea to something people can actually use.</p><p>Today I lead AI engineering at Klyft and build products of my own. Before that I worked on document understanding at DiAS, production AI systems at Chooch, and real-time software at Baykar.</p><p>I studied Electronics and Communication Engineering at Istanbul Technical University and spent an Erasmus semester at Liverpool John Moores University.</p><div class="about-links"><a href={site.resume} target="_blank" rel="noopener noreferrer">View résumé ↗</a><a href={`mailto:${site.email}`}>Email me ↗</a></div></div>
    <div class="about-photo"><img src={site.portrait} alt="Enes Demirağ" width="300" height="300" loading="lazy" /></div>
  </section>
  <section class="content-section"><div class="section-heading"><div><p class="eyebrow">The path so far</p><h2>Experience</h2></div></div><div class="experience-list">{experience.map((item) => <div class="experience-row"><div><strong>{item.role}</strong><span><a href={item.href} target="_blank" rel="noopener noreferrer">{item.company} ↗</a></span></div><time>{item.period}</time></div>)}</div></section>
  <section class="contact content-section"><p class="eyebrow">Let's connect</p><h2>Working on something interesting?</h2><p>I'd love to hear about it.</p><a class="button-link" href={`mailto:${site.email}`}>Send an email ↗</a></section>
</SiteLayout>

<style>
  .page-intro .eyebrow { margin-bottom: 15px; }.about-grid { display: grid; grid-template-columns: minmax(0,1fr) 235px; gap: 70px; align-items: start; }.about-copy p { font-size: .98rem; line-height: 1.9; }.about-photo { padding: 7px; border: 1px solid var(--line); border-radius: 18px; background: white; }.about-photo img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; object-position: center 28%; border-radius: 12px; }.about-links { display: flex; gap: 22px; margin-top: 25px; font-size: .86rem; font-weight: 700; }.about-links a { text-decoration: none; }.experience-row { display: flex; justify-content: space-between; gap: 22px; padding: 17px 0; border-top: 1px solid var(--line); }.experience-row:last-child { border-bottom: 1px solid var(--line); }.experience-row div { display: grid; gap: 2px; }.experience-row strong { font-weight: 660; }.experience-row span, .experience-row a, .experience-row time { color: var(--muted); font-size: .85rem; }.experience-row a { text-decoration: none; }.experience-row a:hover { color: var(--accent); }.experience-row time { white-space: nowrap; }.contact { padding: 31px 0 0; border-top: 1px solid var(--line); }.contact h2 { margin-bottom: 6px; }.contact p:not(.eyebrow) { margin-bottom: 19px; }
  @media (max-width: 650px) { .about-grid { grid-template-columns: 1fr; gap: 25px; }.about-photo { grid-row: 1; width: 160px; }.experience-row { gap: 10px; } }
</style>
