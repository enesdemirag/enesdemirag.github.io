---
import SiteLayout from "../layouts/SiteLayout.astro";
import ProjectRow from "../components/ProjectRow.astro";
import PostRow from "../components/PostRow.astro";
import { site, projects, teamProjects, experience } from "../data/site";
import { getPosts } from "../lib/posts";

const posts = (await getPosts()).slice(0, 4);
---

<SiteLayout>
  <section class="hero">
    <div class="hero-copy">
      <div class="availability"><span class="availability-dot"></span> AI Engineer & Product Builder</div>
      <h1>Hi, I'm Enes <span>Demirağ.</span></h1>
      <p class="hero-lead">I build AI products and the systems behind them.</p>
      <p class="hero-detail">Based in Istanbul. Leading AI at <a href="https://www.klyft-technologies.com" target="_blank" rel="noopener noreferrer">Klyft</a> while building my own products, including CallsReady and Destek Chat.</p>
      <div class="hero-actions">
        <a class="button-link" href="#work">Explore my work <span aria-hidden="true">↗</span></a>
        <a class="quiet-link" href={`mailto:${site.email}`}>Say hello <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="portrait-frame"><img src={site.portrait} alt="Portrait of Enes Demirağ" width="240" height="240" fetchpriority="high" /></div>
  </section>

  <section class="intro-strip" aria-label="Social links">
    <span>Elsewhere on the Internet</span>
    <div>{site.socials.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div>
  </section>

  <section class="content-section" id="work">
    <div class="section-heading"><div><p class="eyebrow">01 / Building</p><h2>Products & Projects</h2></div></div>
    <div>{projects.filter((project) => project.featured).map((project) => <ProjectRow project={project} />)}</div>
    <h3 class="subheading">More Explorations</h3>
    <div>{projects.filter((project) => !project.featured).map((project) => <ProjectRow project={project} />)}</div>
    <h3 class="subheading">University Teams</h3>
    <div>{teamProjects.map((project) => <ProjectRow project={project} />)}</div>
    <p class="work-note">More code and experiments live on <a href="https://github.com/enesdemirag" target="_blank" rel="noopener noreferrer">GitHub ↗</a>.</p>
  </section>

  <section class="content-section about-section" id="about">
    <div class="section-heading"><div><p class="eyebrow">02 / The Person Behind the Work</p><h2>A Little About Me</h2></div></div>
    <div class="about-grid">
      <div class="about-copy">
        <p>I’m an AI engineer based in Istanbul. I like turning messy, real-world problems into useful products and reliable software.</p>
        <p>My work spans agentic systems, voice AI, computer vision, MLOps, and product engineering. I lead AI engineering at Klyft, founded CallsReady and Destek Chat, and co-founded ShelfScan. Earlier roles took me through DiAS, Chooch AI, Outlier, Baykar, and university robotics teams.</p>
        <p>I studied Electronics and Communication Engineering at Istanbul Technical University, then Computer Engineering at the master's level. I also spent an Erasmus semester at Liverpool John Moores University.</p>
        <div class="about-links"><a href={site.resume} target="_blank" rel="noopener noreferrer">View résumé ↗</a><a href={`mailto:${site.email}`}>Email me ↗</a></div>
      </div>
    </div>
    <div class="experience"><h3>Experience</h3><div class="experience-list">{experience.map((item) => <div class="experience-row"><div><strong>{item.role}</strong>{item.href ? <a href={item.href} target="_blank" rel="noopener noreferrer">{item.company} ↗</a> : <span>{item.company}</span>}<span class="experience-focus">{item.focus}</span></div><time>{item.period}</time></div>)}</div></div>
  </section>

  <section class="content-section writing-section">
    <div class="section-heading"><div><p class="eyebrow">03 / Thinking Out Loud</p><h2>Writing</h2></div><a class="text-link" href="/blog/">All Posts →</a></div>
    <p class="section-note">Notes and older essays about software, AI, computer vision, and the things I learn while building.</p>
    <div>{posts.map((post) => <PostRow post={post} />)}</div>
  </section>

  <section class="contact-panel">
    <div><p class="eyebrow">Have Something in Mind?</p><h2>Let's Make It Real.</h2><p>I'm always happy to hear about an interesting product, technical problem, or collaboration.</p></div>
    <div class="contact-actions">
      <a class="button-link" href={site.calendar} target="_blank" rel="noopener noreferrer">Book a meeting ↗</a>
      <a class="text-link" href={`mailto:${site.email}`}>Email me ↗</a>
    </div>
  </section>
</SiteLayout>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) 220px; align-items: center; gap: 54px; padding: 95px 0 83px; }
  .availability { display: inline-flex; align-items: center; gap: 9px; margin-bottom: 24px; color: var(--accent); font-size: .74rem; font-weight: 780; letter-spacing: .1em; text-transform: uppercase; }
  .availability-dot { width: 7px; height: 7px; border-radius: 50%; background: #5baa78; box-shadow: 0 0 0 4px #e7f3e9; }
  h1 { max-width: 610px; margin-bottom: 16px; }
  h1 span { display: block; color: var(--accent); }
  .hero-lead { margin: 0 0 9px; color: var(--ink); font-size: 1.26rem; font-weight: 600; letter-spacing: -.025em; }
  .hero-detail { max-width: 570px; margin-bottom: 26px; font-size: .98rem; line-height: 1.85; }
  .hero-detail a { color: var(--ink); font-weight: 650; }
  .hero-actions { display: flex; align-items: center; gap: 24px; }
  .hero-actions .button-link { gap: 14px; }
  .quiet-link { color: var(--ink); font-size: .86rem; font-weight: 700; text-decoration: none; }
  .quiet-link:hover { color: var(--accent); }
  .portrait-frame { position: relative; width: 220px; height: 220px; padding: 8px; border: 1px solid #d5dcd9; border-radius: 31px; background: #e8eee9; transform: rotate(3deg); box-shadow: 0 15px 35px rgba(15, 35, 41, .08); }
  .portrait-frame::after { position: absolute; z-index: -1; inset: 15px -12px -12px 15px; border: 1px solid #dce4df; border-radius: 31px; content: ""; }
  .portrait-frame img { width: 100%; height: 100%; border-radius: 23px; object-fit: cover; object-position: center 28%; transform: rotate(-3deg); }
  .intro-strip { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 81px; padding: 20px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .intro-strip > span { color: var(--faint); font-size: .82rem; }
  .intro-strip div { display: flex; flex-wrap: wrap; gap: 8px 21px; }
  .intro-strip a { color: var(--ink); font-size: .82rem; font-weight: 650; text-decoration: none; }
  .intro-strip a:hover { color: var(--accent); }
  .section-heading .eyebrow { margin: 0 0 8px; }
  .subheading { margin: 34px 0 12px; color: var(--muted); font-size: .87rem; font-weight: 700; letter-spacing: -.015em; }
  .work-note { margin: 17px 0 0; font-size: .86rem; }
  .work-note a { font-weight: 700; text-decoration: none; }
  .about-section { padding-top: 36px; border-top: 1px solid var(--line); scroll-margin-top: 30px; }
  #work { scroll-margin-top: 30px; }
  .about-copy { max-width: 700px; }
  .about-copy p { font-size: .94rem; line-height: 1.83; }
  .about-links { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 24px; font-size: .85rem; font-weight: 700; }
  .about-links a { text-decoration: none; }
  .experience { margin-top: 48px; }
  .experience h3 { margin: 2px 0 16px; color: var(--faint); font-size: .75rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .experience-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 34px; }
  .experience-row { display: flex; justify-content: space-between; gap: 12px; padding: 13px 0; border-top: 1px solid var(--line); }
  .experience-row:nth-last-child(-n + 2) { border-bottom: 1px solid var(--line); }
  .experience-row div { display: grid; gap: 1px; }
  .experience-row strong { font-size: .84rem; font-weight: 680; }
  .experience-row a, .experience-row span, .experience-row time { color: var(--muted); font-size: .76rem; text-decoration: none; }
  .experience-row .experience-focus { color: var(--faint); font-size: .72rem; }
  .experience-row a:hover { color: var(--accent); }
  .experience-row time { white-space: nowrap; }
  .section-note { max-width: 560px; margin: -5px 0 23px; font-size: .92rem; }
  .contact-panel { display: flex; align-items: center; justify-content: space-between; gap: 30px; margin: 10px 0 85px; padding: 32px 36px; border: 1px solid #dbe5eb; border-radius: 17px; background: #edf3f7; }
  .contact-panel .eyebrow { margin-bottom: 9px; }.contact-panel h2 { margin-bottom: 7px; }.contact-panel p:last-child { max-width: 510px; margin: 0; font-size: .89rem; }
  .contact-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 14px; flex: none; }
  @media (max-width: 700px) { .hero { grid-template-columns: 1fr; gap: 35px; padding: 58px 0 60px; } .portrait-frame { grid-row: 1; width: 128px; height: 128px; border-radius: 22px; } .portrait-frame img { border-radius: 16px; } .intro-strip { align-items: start; flex-direction: column; margin-bottom: 60px; } .experience-list { grid-template-columns: 1fr; } .experience-row:nth-last-child(2) { border-bottom: none; } .contact-panel { align-items: start; flex-direction: column; padding: 26px; } }
</style>
