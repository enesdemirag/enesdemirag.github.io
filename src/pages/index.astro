---
import SiteLayout from "../layouts/SiteLayout.astro";
import ProjectRow from "../components/ProjectRow.astro";
import PostRow from "../components/PostRow.astro";
import { site, projects } from "../data/site";
import { getPosts } from "../lib/posts";

const posts = (await getPosts()).slice(0, 4);
---

<SiteLayout>
  <section class="hero">
    <div class="hero-copy">
      <div class="availability"><span class="availability-dot"></span> AI engineer & product builder</div>
      <h1>Hi, I'm Enes <span>Demirağ.</span></h1>
      <p class="hero-lead">I build AI products and the systems behind them.</p>
      <p class="hero-detail">Based in Istanbul. Leading AI at <a href="https://klyft-technologies.com" target="_blank" rel="noopener noreferrer">Klyft</a>, after working on machine learning and real-time systems at DiAS, Chooch, and Baykar.</p>
      <div class="hero-actions">
        <a class="button-link" href="/work/">Explore my work <span aria-hidden="true">↗</span></a>
        <a class="quiet-link" href={`mailto:${site.email}`}>Say hello <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="portrait-frame"><img src={site.portrait} alt="Portrait of Enes Demirağ" width="240" height="240" fetchpriority="high" /></div>
  </section>

  <section class="intro-strip" aria-label="Social links">
    <span>Elsewhere on the internet</span>
    <div>{site.socials.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div>
  </section>

  <section class="content-section">
    <div class="section-heading"><div><p class="eyebrow">01 / Building</p><h2>Selected products</h2></div><a class="text-link" href="/work/">All work →</a></div>
    <div>{projects.filter((project) => project.featured).map((project) => <ProjectRow project={project} />)}</div>
  </section>

  <section class="content-section writing-section">
    <div class="section-heading"><div><p class="eyebrow">02 / Thinking out loud</p><h2>Writing</h2></div><a class="text-link" href="/blog/">All posts →</a></div>
    <p class="section-note">Notes and older essays about software, AI, computer vision, and the things I learn while building.</p>
    <div>{posts.map((post) => <PostRow post={post} />)}</div>
  </section>

  <section class="contact-panel">
    <div><p class="eyebrow">Have something in mind?</p><h2>Let's make it real.</h2><p>I'm always happy to hear about an interesting product, technical problem, or collaboration.</p></div>
    <a class="button-link" href={`mailto:${site.email}`}>Get in touch ↗</a>
  </section>
</SiteLayout>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) 220px; align-items: center; gap: 54px; padding: 95px 0 83px; }
  .availability { display: inline-flex; align-items: center; gap: 9px; margin-bottom: 24px; color: var(--accent); font-size: .74rem; font-weight: 780; letter-spacing: .1em; text-transform: uppercase; }
  .availability-dot { width: 7px; height: 7px; border-radius: 50%; background: #5baa78; box-shadow: 0 0 0 4px #e7f3e9; }
  h1 { max-width: 610px; margin-bottom: 16px; }
  h1 span { display: block; color: var(--accent); }
  .hero-lead { margin: 0 0 9px; color: var(--ink); font-size: 1.26rem; font-weight: 600; letter-spacing: -.025em; }
  .hero-detail { max-width: 570px; margin-bottom: 26px; font-size: .98rem; line-height: 1.85; }
  .hero-detail a { color: var(--ink); font-weight: 650; }
  .hero-actions { display: flex; align-items: center; gap: 24px; }
  .hero-actions .button-link { gap: 14px; }
  .quiet-link { color: var(--ink); font-size: .86rem; font-weight: 700; text-decoration: none; }
  .quiet-link:hover { color: var(--accent); }
  .portrait-frame { position: relative; width: 220px; height: 220px; padding: 8px; border: 1px solid #d5dcd9; border-radius: 31px; background: #e8eee9; transform: rotate(3deg); box-shadow: 0 15px 35px rgba(15, 35, 41, .08); }
  .portrait-frame::after { position: absolute; z-index: -1; inset: 15px -12px -12px 15px; border: 1px solid #dce4df; border-radius: 31px; content: ""; }
  .portrait-frame img { width: 100%; height: 100%; border-radius: 23px; object-fit: cover; object-position: center 28%; transform: rotate(-3deg); }
  .intro-strip { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 81px; padding: 20px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .intro-strip > span { color: var(--faint); font-size: .82rem; }
  .intro-strip div { display: flex; flex-wrap: wrap; gap: 8px 21px; }
  .intro-strip a { color: var(--ink); font-size: .82rem; font-weight: 650; text-decoration: none; }
  .intro-strip a:hover { color: var(--accent); }
  .section-heading .eyebrow { margin: 0 0 8px; }
  .section-note { max-width: 560px; margin: -5px 0 23px; font-size: .92rem; }
  .contact-panel { display: flex; align-items: center; justify-content: space-between; gap: 30px; margin: 10px 0 85px; padding: 32px 36px; border: 1px solid #dbe5eb; border-radius: 17px; background: #edf3f7; }
  .contact-panel .eyebrow { margin-bottom: 9px; }.contact-panel h2 { margin-bottom: 7px; }.contact-panel p:last-child { max-width: 510px; margin: 0; font-size: .89rem; }
  .contact-panel .button-link { flex: none; }
  @media (max-width: 700px) { .hero { grid-template-columns: 1fr; gap: 35px; padding: 58px 0 60px; } .portrait-frame { grid-row: 1; width: 128px; height: 128px; border-radius: 22px; } .portrait-frame img { border-radius: 16px; } .intro-strip { align-items: start; flex-direction: column; margin-bottom: 60px; } .contact-panel { align-items: start; flex-direction: column; padding: 26px; } }
</style>
