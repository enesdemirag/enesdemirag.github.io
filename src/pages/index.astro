---
import SiteLayout from "../layouts/SiteLayout.astro";
import ExperienceRow from "../components/ExperienceRow.astro";
import PostRow from "../components/PostRow.astro";
import { site } from "../data/site";
import { experience } from "../data/experience";
import { getPosts } from "../lib/posts";

const posts = (await getPosts()).slice(0, 4);
---

<SiteLayout>
  <section class="hero">
    <h1>Enes Demirağ</h1>
    <p class="hero-subtitle">AI Engineer & Product Builder</p>
    <p class="hero-description">I build AI products and the systems behind them. Based in Istanbul, I lead AI engineering at Klyft and build products of my own.</p>
    <nav class="social-links" aria-label="Social links">
      {site.socials.map((link) => <a href={link.href} aria-label={link.label} title={link.label} target="_blank" rel="noopener noreferrer"><img src={link.icon} alt="" width="20" height="20" /></a>)}
    </nav>
    <div class="hero-actions">
      <a class="button-link" href={`mailto:${site.email}`}>Email Me ↗</a>
      <a class="button-link secondary-button" href={site.calendar} target="_blank" rel="noopener noreferrer">Book a Meeting ↗</a>
    </div>
    <nav class="product-links" aria-label="Selected products and work">
      {experience.slice(0, 4).map((item) => <a href={item.href ?? undefined} target="_blank" rel="noopener noreferrer">{item.name} ↗</a>)}
    </nav>
  </section>

  <section class="content-section" id="experience">
    <div class="section-heading"><div><p class="eyebrow">01 / Building</p><h2>Experience</h2></div></div>
    <div>{experience.slice(0, 8).map((item) => <ExperienceRow item={item} />)}</div>
    <a class="button-link more-button" href="/experience/">More Experience <span aria-hidden="true">→</span></a>
  </section>

  <section class="content-section about-section" id="about">
    <div class="section-heading"><div><p class="eyebrow">02 / The Person Behind the Work</p><h2>A Little About Me</h2></div></div>
    <div class="about-grid">
      <div class="about-copy">
        <p>I’m an AI engineer based in Istanbul. I like turning messy, real-world problems into useful products and reliable software.</p>
        <p>My work spans agentic systems, voice AI, computer vision, MLOps, and product engineering. I lead AI engineering at Klyft, founded CallsReady and DestekChat, and co-founded ShelfScan. Earlier roles took me through DiAS, Chooch, Outlier, Baykar, and university robotics teams.</p>
        <p>I studied Electronics and Communication Engineering at Istanbul Technical University, then Computer Engineering at the master's level. I also spent an Erasmus semester at Liverpool John Moores University.</p>
        <div class="about-links"><a href={site.resume} target="_blank" rel="noopener noreferrer">View résumé ↗</a><a href={`mailto:${site.email}`}>Email me ↗</a></div>
      </div>
    </div>
  </section>

  <section class="content-section writing-section">
    <div class="section-heading"><div><p class="eyebrow">03 / Thinking Out Loud</p><h2>Writing</h2></div><a class="text-link" href="/blog/">All Posts →</a></div>
    <p class="section-note">Posts and essays about software, AI, computer vision, and the things I learn while building.</p>
    <div>{posts.map((post) => <PostRow post={post} />)}</div>
  </section>

  <section class="contact-panel">
    <div><p class="eyebrow">Have Something in Mind?</p><h2>Let's Make It Real.</h2><p>I'm always happy to hear about an interesting product, technical problem, or collaboration.</p></div>
    <div class="contact-actions">
      <a class="button-link" href={site.calendar} target="_blank" rel="noopener noreferrer">Book a meeting ↗</a>
      <a class="text-link" href={`mailto:${site.email}`}>Email me ↗</a>
    </div>
  </section>
</SiteLayout>

<style>
  .hero { padding: 92px 0 90px; }
  .hero h1 { margin-bottom: 7px; }
  .hero-subtitle { margin-bottom: 15px; color: var(--ink); font-size: 1.15rem; font-weight: 660; letter-spacing: -.02em; }
  .hero-description { max-width: 590px; margin-bottom: 24px; font-size: 1rem; line-height: 1.8; }
  .social-links { display: flex; align-items: center; gap: 10px; margin-bottom: 27px; }
  .social-links a { display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); transition: border-color .2s, transform .2s; }
  .social-links a:hover { border-color: var(--accent); transform: translateY(-2px); }
  .social-links img { width: 18px; height: 18px; opacity: .8; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 24px; }
  .secondary-button { border: 1px solid var(--line); background: var(--surface); color: var(--ink); }
  .secondary-button:hover { border-color: var(--accent); color: white; }
  .product-links { display: flex; flex-wrap: wrap; gap: 8px; }
  .product-links a { display: inline-flex; align-items: center; min-height: 36px; padding: 0 12px; border: 1px solid var(--line); border-radius: 9px; color: var(--muted); font-size: .78rem; font-weight: 650; text-decoration: none; }
  .product-links a:hover { border-color: var(--accent); color: var(--accent); }
  .section-heading .eyebrow { margin: 0 0 8px; }
  .more-button { gap: 12px; margin-top: 24px; }
  .about-section { padding-top: 36px; border-top: 1px solid var(--line); scroll-margin-top: 30px; }
  #experience { scroll-margin-top: 30px; }
  .about-copy { max-width: 700px; }
  .about-copy p { font-size: .94rem; line-height: 1.83; }
  .about-links { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 24px; font-size: .85rem; font-weight: 700; }
  .about-links a { text-decoration: none; }
  .section-note { max-width: 560px; margin: -5px 0 23px; font-size: .92rem; }
  .contact-panel { display: flex; align-items: center; justify-content: space-between; gap: 30px; margin: 10px 0 85px; padding: 32px 36px; border: 1px solid #dbe5eb; border-radius: 17px; background: #edf3f7; }
  .contact-panel .eyebrow { margin-bottom: 9px; }.contact-panel h2 { margin-bottom: 7px; }.contact-panel p:last-child { max-width: 510px; margin: 0; font-size: .89rem; }
  .contact-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 14px; flex: none; }
  @media (max-width: 700px) { .hero { padding: 58px 0 65px; } .contact-panel { align-items: start; flex-direction: column; padding: 26px; } }
</style>
