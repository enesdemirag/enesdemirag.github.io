---
import SiteLayout from "../layouts/SiteLayout.astro";
import ExperienceRow from "../components/ExperienceRow.astro";
import PostRow from "../components/PostRow.astro";
import { site } from "../data/site";
import { experience } from "../data/experience";
import { getPosts } from "../lib/posts";

const posts = (await getPosts()).slice(0, 4);
---

<SiteLayout>
  <section class="hero">
    <div class="hero-copy">
      <h1>Enes Demirağ</h1>
      <p class="hero-subtitle">AI Engineer</p>
      <p class="hero-description">I build AI products and the systems behind them. Based in Istanbul, I lead AI engineering at Klyft and build products of my own.</p>
      <nav class="social-links" aria-label="Social links">
        {site.socials.map((link) => <a href={link.href} aria-label={link.label} title={link.label} target="_blank" rel="noopener noreferrer"><img src={link.icon} alt="" width="20" height="20" /></a>)}
      </nav>
      <div class="hero-actions">
        <a class="button-link" href={`mailto:${site.email}`}>Email Me ↗</a>
        <a class="button-link secondary-button" href={site.calendar} target="_blank" rel="noopener noreferrer">Book a Meeting ↗</a>
        <a class="button-link secondary-button" href={site.resume} target="_blank" rel="noopener noreferrer">View Résumé ↗</a>
      </div>
    </div>
    <img class="hero-photo" src="/images/profile.jpg" alt="Portrait of Enes Demirağ" width="196" height="196" decoding="async" />
  </section>

  <section class="content-section" id="experience">
    <div class="section-heading"><h2>Experience</h2></div>
    <div>{experience.slice(0, 8).map((item) => <ExperienceRow item={item} />)}</div>
    <a class="button-link more-button" href="/experience/">More Experience <span aria-hidden="true">→</span></a>
  </section>

  <section class="content-section blog-section">
    <div class="section-heading"><h2>Blog</h2></div>
    <p class="section-note">Posts and essays about software, AI, computer vision, and the things I learn while building.</p>
    <div>{posts.map((post) => <PostRow post={post} />)}</div>
    <a class="button-link more-button" href="/blog/">More Posts <span aria-hidden="true">→</span></a>
  </section>

  <section class="contact-panel">
    <div><p class="eyebrow">Have Something in Mind?</p><h2>Let's Make It Real.</h2><p>I'm always happy to hear about an interesting product, technical problem, or collaboration.</p></div>
    <div class="contact-actions">
      <a class="button-link" href={site.calendar} target="_blank" rel="noopener noreferrer">Book a meeting ↗</a>
      <a class="button-link secondary-button" href={`mailto:${site.email}`}>Email me ↗</a>
    </div>
  </section>
</SiteLayout>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) 180px; align-items: center; gap: clamp(28px, 5vw, 56px); padding: 72px 0 80px; }
  .hero-copy { min-width: 0; }
  .hero-photo { display: block; width: 180px; height: 180px; object-fit: cover; border: 1px solid var(--line); border-radius: 18px; }
  .hero h1 { margin-bottom: 8px; }
  .hero-subtitle { margin-bottom: 16px; color: var(--ink); font-size: 1.15rem; font-weight: 600; }
  .hero-description { max-width: 590px; margin-bottom: 24px; line-height: 1.75; }
  .social-links { display: flex; align-items: center; gap: 8px; margin-bottom: 28px; }
  .social-links a { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg); transition: border-color .15s ease, background .15s ease; }
  .social-links a:hover { border-color: var(--faint); background: var(--soft); }
  .social-links img { width: 18px; height: 18px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .secondary-button { border-color: var(--line); background: var(--bg); color: var(--ink); }
  .secondary-button:hover { border-color: var(--faint); background: var(--soft); }
  .more-button { gap: 10px; margin-top: 24px; }
  #experience { scroll-margin-top: 30px; }
  .section-note { max-width: 560px; margin: -5px 0 23px; font-size: .95rem; }
  .contact-panel { display: flex; align-items: center; justify-content: space-between; gap: 30px; margin: 10px 0 85px; padding: 32px 36px; border: 1px solid var(--line); border-radius: calc(var(--radius) + 6px); background: var(--soft); }
  .contact-panel .eyebrow { margin-bottom: 6px; }.contact-panel h2 { margin-bottom: 7px; }.contact-panel p:last-child { max-width: 510px; margin: 0; font-size: .92rem; }
  .contact-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; flex: none; }
  @media (max-width: 700px) { .hero { grid-template-columns: 1fr; gap: 24px; padding: 40px 0 64px; } .hero-photo { grid-row: 1; width: 120px; height: 120px; } .contact-panel { align-items: start; flex-direction: column; padding: 26px; } }
</style>
